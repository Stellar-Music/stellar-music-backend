PORT=4000
NODE_ENV=development

# Database Configuration
# If DATABASE_URL is not set or unreachable, the system automatically uses local SQLite (data/stellar_music.db)
DATABASE_URL=postgresql://stellar_user:stellar_password@localhost:5432/stellar_music

# Stellar Network Configuration
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

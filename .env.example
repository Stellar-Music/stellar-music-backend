# ==============================================================================
# Stellar Music Backend — Environment Configuration
# ==============================================================================

# Server Network & Runtime
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Database Configuration
# PostgreSQL connection string. If omitted or unreachable, SQLite is used automatically (data/stellar_music.db).
DATABASE_URL=postgresql://stellar_user:stellar_secret_password@localhost:5432/stellar_music

# Stellar Testnet Horizon & Network
STELLAR_NETWORK=TESTNET
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_HORIZON_FALLBACK_URL=https://rpc-testnet.stellar.org
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org
STELLAR_CONTRACT_ID=

# HMAC Audio Streaming Security (Minimum 32 random characters in production)
STREAM_SIGNING_SECRET=stellar_music_super_secure_hmac_secret_key_32_chars
STREAM_TOKEN_TTL_SECONDS=300

# Rate Limiting & Denial of Service Protection
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Realtime Server-Sent Events (SSE) Keepalive
SSE_PING_INTERVAL_MS=15000
